# Settings for `npm start` (the demo and tests need none of these).
# 1. Copy this file and name the copy ".env". Never commit .env.

# Shopify admin → Settings → Notifications → Webhooks: the signing secret shown
# there (or your custom app's client secret if the app registers the webhook)
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret

# The public address of this app. The NFC chips point to PUBLIC_URL/t/<tag id>.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Products whose SKU starts with this get an NFC tag
NFC_SKU_PREFIX=NFC-

# Optional: save tags to this JSON file so they survive a restart
# DATA_FILE=data/tags.json
