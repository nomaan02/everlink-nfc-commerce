<section class="main-search" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="search-header">
      <h1 class="search-header__title">{{ 'templates.search.title' | t }}</h1>

      {% form 'search', class: 'search-form' %}
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.search' | t }}"
          class="search-input"
        >
        <button type="submit" class="button button--primary">
          {{ 'general.search.search' | t }}
        </button>
      {% endform %}
    </div>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <div class="search-results">
          <p class="search-results__count">
            {{ 'templates.search.results_with_count' | t: count: search.results_count }}
          </p>

          <div class="product-grid product-grid--4-col">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="search-empty">
          <p>{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .main-search {
    padding: 4rem 0;
  }

  .search-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .search-header__title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 2rem;
    color: var(--color-primary);
  }

  .search-form {
    display: flex;
    gap: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .search-input {
    flex: 1;
    padding: 1rem;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    font-size: 1rem;
  }

  .search-results__count {
    margin-bottom: 2rem;
    font-size: 1.125rem;
    color: var(--color-text-light);
  }

  .search-empty {
    text-align: center;
    padding: 4rem 0;
  }
</style>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
