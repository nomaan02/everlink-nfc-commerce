<section class="newsletter" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="newsletter__wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="newsletter__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {% form 'customer', class: 'newsletter__form' %}
        {%- if form.posted_successfully? -%}
          <div class="newsletter__success">
            {{ section.settings.success_message }}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="newsletter__error">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="newsletter__input-wrapper">
          <input
            type="email"
            name="contact[email]"
            id="NewsletterEmail-{{ section.id }}"
            class="newsletter__input"
            placeholder="{{ section.settings.placeholder_text }}"
            required
            aria-label="Email address"
          >
          <button type="submit" class="newsletter__button button button--primary">
            {{ section.settings.button_text }}
          </button>
        </div>

        {%- if section.settings.show_privacy_notice -%}
          <p class="newsletter__privacy">
            {{ section.settings.privacy_notice }}
          </p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

<style>
  .newsletter {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .newsletter__wrapper {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .newsletter__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
    color: {{ section.settings.heading_color }};
  }

  .newsletter__subheading {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  .newsletter__input-wrapper {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .newsletter__input {
    flex: 1;
    padding: 1rem;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
  }

  .newsletter__input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .newsletter__button {
    white-space: nowrap;
  }

  .newsletter__privacy {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .newsletter__success {
    padding: 1rem;
    background: var(--color-success);
    color: white;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .newsletter__error {
    padding: 1rem;
    background: var(--color-error);
    color: white;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .newsletter__input-wrapper {
      flex-direction: column;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay Connected"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe to receive updates about new collections and exclusive offers"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder Text",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for subscribing!"
    },
    {
      "type": "checkbox",
      "id": "show_privacy_notice",
      "label": "Show Privacy Notice",
      "default": true
    },
    {
      "type": "text",
      "id": "privacy_notice",
      "label": "Privacy Notice",
      "default": "We respect your privacy and will never share your email."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#E8F4F8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#6BA4CE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
