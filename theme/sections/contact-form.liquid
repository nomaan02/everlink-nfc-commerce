<section class="contact-form" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="contact-form__wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="contact-form__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="contact-form__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {% form 'contact', class: 'contact-form__form' %}
        {%- if form.posted_successfully? -%}
          <div class="contact-form__success">
            {{ section.settings.success_message }}
          </div>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <div class="contact-form__fields">
          <div class="contact-form__field">
            <label for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
            <input
              type="text"
              id="ContactForm-name"
              name="contact[name]"
              required
            >
          </div>

          <div class="contact-form__field">
            <label for="ContactForm-email">{{ 'templates.contact.form.email' | t }}</label>
            <input
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              required
            >
          </div>

          <div class="contact-form__field">
            <label for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
            <input
              type="tel"
              id="ContactForm-phone"
              name="contact[phone]"
            >
          </div>

          <div class="contact-form__field contact-form__field--full">
            <label for="ContactForm-message">{{ 'templates.contact.form.comment' | t }}</label>
            <textarea
              id="ContactForm-message"
              name="contact[body]"
              rows="6"
              required
            ></textarea>
          </div>

          <div class="contact-form__submit">
            <button type="submit" class="button button--primary">
              {{ 'templates.contact.form.send' | t }}
            </button>
          </div>
        </div>
      {% endform %}
    </div>
  </div>
</section>

<style>
  .contact-form {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .contact-form__wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-form__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .contact-form__subheading {
    text-align: center;
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  .contact-form__fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__field label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    padding: 1rem;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .contact-form__submit {
    grid-column: 1 / -1;
    text-align: center;
  }

  .contact-form__success {
    padding: 1rem;
    background: var(--color-success);
    color: white;
    border-radius: 4px;
    margin-bottom: 2rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .contact-form__fields {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Have a question? We'd love to hear from you."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for contacting us. We'll get back to you soon!"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
