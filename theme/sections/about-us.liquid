<section class="about-us" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="about-us__grid">
      {%- if section.settings.image != blank -%}
        <div class="about-us__image-wrapper">
          {{ section.settings.image | image_url: width: 1000 | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 50vw, 100vw'
          }}
        </div>
      {%- endif -%}

      <div class="about-us__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="about-us__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="about-us__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .about-us {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .about-us__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-us__image-wrapper img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .about-us__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }

  .about-us__text {
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  @media (max-width: 989px) {
    .about-us__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "About Us",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Everlink"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We combine timeless luxury jewelry with cutting-edge NFC technology to create personalized heirlooms for the modern age. Each piece tells your unique story.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "About Us"
    }
  ]
}
{% endschema %}
