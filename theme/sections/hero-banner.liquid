<section class="hero-banner" data-section-id="{{ section.id }}" data-section-type="hero-banner">
  <div class="hero-banner__wrapper">
    {%- if section.settings.image != blank -%}
      <div class="hero-banner__image">
        {{ section.settings.image | image_url: width: 2000 | image_tag:
          loading: 'eager',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000'
        }}
      </div>
    {%- endif -%}

    <div class="hero-banner__content page-width">
      <div class="hero-banner__text-wrapper">
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-banner__heading">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="hero-banner__subheading">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="hero-banner__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="hero-banner__buttons">
            <a href="{{ section.settings.button_link }}" class="button button--primary">
              {{ section.settings.button_label }}
            </a>
            {%- if section.settings.button_label_2 != blank -%}
              <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
                {{ section.settings.button_label_2 }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    min-height: {{ section.settings.section_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: {{ section.settings.background_color }};
  }

  .hero-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-banner__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
  }

  .hero-banner__content {
    position: relative;
    z-index: 2;
    text-align: {{ section.settings.text_alignment }};
  }

  .hero-banner__heading {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    color: {{ section.settings.heading_color }};
    margin-bottom: 1rem;
    text-transform: lowercase;
  }

  .hero-banner__subheading {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: {{ section.settings.text_color }};
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .hero-banner__text {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: {{ section.settings.text_color }};
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-banner__buttons {
    display: flex;
    gap: 1rem;
    justify-content: {{ section.settings.text_alignment }};
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero-banner {
      min-height: {{ section.settings.section_height_mobile }}vh;
    }

    .hero-banner__buttons {
      flex-direction: column;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Opacity",
      "default": 30
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#E8F4F8"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section Height (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section Height (Mobile)",
      "default": 70
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "everlink"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "a new era of personalisation"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Luxury heirlooms driven by the latest in NFC technology</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#6BA4CE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "settings": {
        "heading": "everlink",
        "subheading": "a new era of personalisation",
        "text": "<p>Luxury heirlooms driven by the latest in NFC technology</p>"
      }
    }
  ]
}
{% endschema %}
