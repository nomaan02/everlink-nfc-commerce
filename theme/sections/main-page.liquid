<section class="main-page" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="page-header">
      <h1 class="page-header__title">{{ page.title }}</h1>
    </div>

    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</section>

<style>
  .main-page {
    padding: 4rem 0;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header__title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-primary);
  }

  .page-content {
    max-width: 800px;
    margin: 0 auto;
    font-size: 1.125rem;
    line-height: 1.7;
  }
</style>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
