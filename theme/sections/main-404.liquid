<section class="main-404" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="error-404__content">
      <h1 class="error-404__code">404</h1>
      <h2 class="error-404__title">{{ 'templates.404.title' | t }}</h2>
      <p class="error-404__text">{{ 'templates.404.subtext' | t }}</p>
      <a href="{{ routes.root_url }}" class="button button--primary">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  </div>
</section>

<style>
  .main-404 {
    padding: 6rem 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-404__content {
    text-align: center;
  }

  .error-404__code {
    font-size: 8rem;
    font-weight: 300;
    color: var(--color-primary);
    margin-bottom: 1rem;
    line-height: 1;
  }

  .error-404__title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .error-404__text {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: var(--color-text-light);
  }
</style>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
