<div class="customer-addresses page-width">
  <h1 class="addresses__title">{{ 'customer.addresses.title' | t }}</h1>

  <button type="button" class="button button--primary" onclick="toggleAddressForm('new')">
    {{ 'customer.addresses.add_new' | t }}
  </button>

  <div id="AddressNewForm" style="display: none; margin-top: 2rem;">
    {% form 'customer_address', customer.new_address, class: 'address-form' %}
      <h2>{{ 'customer.addresses.add_new' | t }}</h2>

      <div class="form-grid">
        <div class="form-field">
          <label for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t }}</label>
          <input type="text" name="address[first_name]" id="AddressFirstNameNew" required>
        </div>

        <div class="form-field">
          <label for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t }}</label>
          <input type="text" name="address[last_name]" id="AddressLastNameNew" required>
        </div>

        <div class="form-field form-field--full">
          <label for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
          <input type="text" name="address[company]" id="AddressCompanyNew">
        </div>

        <div class="form-field form-field--full">
          <label for="AddressAddress1New">{{ 'customer.addresses.address1' | t }}</label>
          <input type="text" name="address[address1]" id="AddressAddress1New" required>
        </div>

        <div class="form-field form-field--full">
          <label for="AddressAddress2New">{{ 'customer.addresses.address2' | t }}</label>
          <input type="text" name="address[address2]" id="AddressAddress2New">
        </div>

        <div class="form-field">
          <label for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
          <input type="text" name="address[city]" id="AddressCityNew" required>
        </div>

        <div class="form-field">
          <label for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
          <select name="address[country]" id="AddressCountryNew" required>
            {{ all_country_option_tags }}
          </select>
        </div>

        <div class="form-field">
          <label for="AddressProvinceNew">{{ 'customer.addresses.province' | t }}</label>
          <input type="text" name="address[province]" id="AddressProvinceNew">
        </div>

        <div class="form-field">
          <label for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
          <input type="text" name="address[zip]" id="AddressZipNew" required>
        </div>

        <div class="form-field form-field--full">
          <label for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
          <input type="tel" name="address[phone]" id="AddressPhoneNew">
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="button button--primary">
          {{ 'customer.addresses.add' | t }}
        </button>
        <button type="button" class="button button--secondary" onclick="toggleAddressForm('new')">
          {{ 'customer.addresses.cancel' | t }}
        </button>
      </div>
    {% endform %}
  </div>

  <div class="addresses-list">
    {%- for address in customer.addresses -%}
      <div class="address-card">
        <div class="address-card__content">
          {{ address | format_address }}
          {%- if address == customer.default_address -%}
            <p class="address-card__badge">{{ 'customer.addresses.default' | t }}</p>
          {%- endif -%}
        </div>

        <div class="address-card__actions">
          <button type="button" onclick="editAddress({{ address.id }})">
            {{ 'customer.addresses.edit' | t }}
          </button>
          <button type="button" onclick="deleteAddress({{ address.id }})">
            {{ 'customer.addresses.delete' | t }}
          </button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .customer-addresses {
    padding: 4rem 0;
  }

  .addresses__title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 2rem;
    color: var(--color-primary);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .form-field--full {
    grid-column: 1 / -1;
  }

  .form-field label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .form-field input,
  .form-field select {
    width: 100%;
    padding: 0.75rem;
    border: 2px solid var(--color-border);
    border-radius: 4px;
  }

  .form-actions {
    display: flex;
    gap: 1rem;
  }

  .addresses-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .address-card {
    padding: 2rem;
    border: 2px solid var(--color-border);
    border-radius: 8px;
  }

  .address-card__badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-primary);
    color: white;
    border-radius: 4px;
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .address-card__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .address-card__actions button {
    background: none;
    border: none;
    color: var(--color-primary);
    cursor: pointer;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function toggleAddressForm(id) {
    const form = document.getElementById(`AddressNewForm`);
    if (form.style.display === 'none') {
      form.style.display = 'block';
    } else {
      form.style.display = 'none';
    }
  }

  function editAddress(id) {
    // Implementation would go here
    alert('Edit address: ' + id);
  }

  function deleteAddress(id) {
    if (confirm('{{ 'customer.addresses.delete_confirm' | t }}')) {
      // Implementation would go here
      alert('Delete address: ' + id);
    }
  }
</script>
