<div class="customer-account page-width">
  <h1 class="account__title">{{ 'customer.account.title' | t }}</h1>

  <div class="account__content">
    <div class="account__details">
      <h2>{{ 'customer.account.details' | t }}</h2>
      <p>{{ customer.name }}</p>
      <p>{{ customer.email }}</p>
    </div>

    <div class="account__orders">
      <div class="account__orders-header">
        <h2>{{ 'customer.orders.title' | t }}</h2>
        <a href="{{ routes.account_addresses_url }}" class="button button--secondary">
          {{ 'customer.account.view_addresses' | t }}
        </a>
      </div>

      {%- if customer.orders.size > 0 -%}
        <table class="account__orders-table">
          <thead>
            <tr>
              <th>{{ 'customer.orders.order_number' | t }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.payment_status' | t }}</th>
              <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
              <th>{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td>
                  <a href="{{ order.customer_url }}">{{ order.name }}</a>
                </td>
                <td>{{ order.created_at | date: "%B %d, %Y" }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p>{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .customer-account {
    padding: 4rem 0;
  }

  .account__title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 3rem;
    color: var(--color-primary);
  }

  .account__content {
    display: grid;
    gap: 3rem;
  }

  .account__orders-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .account__orders-table {
    width: 100%;
    border-collapse: collapse;
  }

  .account__orders-table th {
    text-align: left;
    padding: 1rem;
    border-bottom: 2px solid var(--color-border);
    font-weight: 600;
  }

  .account__orders-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .account__orders-table {
      font-size: 0.875rem;
    }

    .account__orders-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
