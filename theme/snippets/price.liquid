{%- comment -%}
  Renders product price

  Accepts:
  - product: {Object} Product object

  Usage:
  {% render 'price', product: product %}
{%- endcomment -%}

{%- liquid
  assign money_price = product.price | money
  assign compare_at_price = product.compare_at_price | money
  assign price_min = product.price_min | money
  assign price_max = product.price_max | money
-%}

<div class="price {%- if product.price_varies %} price--varies {%- endif -%} {%- if product.compare_at_price > product.price %} price--on-sale {%- endif -%}">
  <div class="price__container">
    {%- if product.price_varies -%}
      <span class="price__label">{{ 'products.product.price.from_price_html' | t }}</span>
    {%- endif -%}

    <span class="price__regular">
      {%- if product.price_varies -%}
        {{ price_min }}
        {%- if price_min != price_max -%}
          - {{ price_max }}
        {%- endif -%}
      {%- else -%}
        {{ money_price }}
      {%- endif -%}
    </span>

    {%- if product.compare_at_price > product.price -%}
      <span class="price__sale">
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        <s>{{ compare_at_price }}</s>
      </span>
    {%- endif -%}
  </div>

  {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
    <div class="price__unit">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {{ product.selected_or_first_available_variant.unit_price | money }}
      <span>/</span>
      {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
        {{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}
      {%- endif -%}
      {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
    </div>
  {%- endif -%}
</div>
