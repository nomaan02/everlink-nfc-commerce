<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#6BA4CE">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {{ content_for_header }}

    {{ 'application.css' | asset_url | stylesheet_tag }}
    {{ 'custom.css' | asset_url | stylesheet_tag }}

    <style>
      .password-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #E8F4F8 0%, #B8D8E8 100%);
        padding: 2rem;
      }

      .password-container {
        max-width: 500px;
        width: 100%;
        background: white;
        padding: 3rem;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        text-align: center;
      }

      .password-logo {
        font-size: 3rem;
        font-weight: 300;
        color: #6BA4CE;
        margin-bottom: 1rem;
        letter-spacing: 2px;
      }

      .password-message {
        font-size: 1.125rem;
        color: #333;
        margin-bottom: 2rem;
        line-height: 1.6;
      }

      .password-form {
        margin-bottom: 2rem;
      }

      .password-input {
        width: 100%;
        padding: 1rem;
        border: 2px solid #E0E0E0;
        border-radius: 4px;
        font-size: 1rem;
        margin-bottom: 1rem;
        transition: border-color 0.3s;
      }

      .password-input:focus {
        outline: none;
        border-color: #6BA4CE;
      }

      .password-button {
        width: 100%;
        padding: 1rem;
        background: #6BA4CE;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
      }

      .password-button:hover {
        background: #5A92B8;
      }

      .password-error {
        color: #E74C3C;
        margin-top: 1rem;
      }

      .password-footer {
        font-size: 0.875rem;
        color: #999;
      }
    </style>
  </head>

  <body class="password-page">
    <div class="password-container">
      <h1 class="password-logo">everlink</h1>
      <p class="password-message">
        We're preparing something extraordinary. Our luxury jewelry collection with NFC technology is coming soon.
      </p>

      {% form 'storefront_password', class: 'password-form' %}
        {{ form.errors | default_errors }}

        <input
          type="password"
          name="password"
          id="Password"
          class="password-input"
          placeholder="Enter password"
          autofocus
        >

        <button type="submit" name="commit" class="password-button">
          Enter
        </button>

        {% if form.errors %}
          <p class="password-error">{{ 'general.password_page.login_form_error' | t }}</p>
        {% endif %}
      {% endform %}

      <div class="password-footer">
        <p>{{ 'general.password_page.admin_link_html' | t }}</p>
      </div>
    </div>
  </body>
</html>
